# /etc/systemd/system/f12-backend.service
#
# Installeer met:
#   sudo cp f12-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now f12-backend
#
# Logs bekijken: sudo journalctl -u f12-backend -f

[Unit]
Description=F12 Scanner FastAPI backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/f12
Environment="PATH=/var/www/f12/venv/bin"
ExecStart=/var/www/f12/venv/bin/uvicorn main:app --host 127.0.0.1 --port 6677 --workers 2
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/f12
ProtectHome=true

[Install]
WantedBy=multi-user.target
